Package: ubrus
Version: @VERSION@
Architecture: @ARCH@
Maintainer: Ubrus contributors <ubrus@localhost>
Section: gnome
Priority: optional
Depends: gnome-shell (>= 46), libgtk-4-1 (>= 4.14), libglib2.0-0t64, libgdk-pixbuf-2.0-0, libx11-6, libx11-xcb1, libxcb-shm0, libxkbcommon-x11-0, libwayland-client0, libgstreamer1.0-0 (>= 1.24), libgstreamer-plugins-base1.0-0, gstreamer1.0-plugins-base, gstreamer1.0-plugins-good, gstreamer1.0-gl, gstreamer1.0-libav, librsvg2-common, webp-pixbuf-loader, xdg-desktop-portal-gnome
